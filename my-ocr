INPATH = os.environ["OCR_INPATH"]
# checked by export_config_check before this runs: MRC 0/1, quality 0/1/2
MRC    = os.environ["OCR_EXPORT_MRC"] == "1"
QUAL   = int(os.environ["OCR_EXPORT_QUALITY"])

