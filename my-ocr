  echo "$US --run-tests   ($(head -1 "$0"))"
  T_TMP="$(mktemp -d /tmp/my-ocr.tests.XXXXXX)" || { echo "mktemp failed"; return 1; }
  t_shebang
  t_dash_syntax
  t_file_option
  t_cleanup_pattern_interpreter_agnostic
