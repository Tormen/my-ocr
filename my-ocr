  _sw_rc=$?
  if [ "$_sw_rc" -ne 0 ]; then
    err 137 "FAILED [$_sw_rc] to generate '$_sw_doc': $(tail -n 3 "$_sw_err" | tr '\n' ' ')"
    rm -f "$_sw_err"; return 1
  fi
  rm -f "$_sw_err"

