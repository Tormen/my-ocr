# A multi-step workflow does NOT chain by array order: Automator follows the
# connectors, and without them the OCR step and part-2 never receive input.
def link(a, b):
    return {"from": "%s - %s" % (a, a), "to": "%s - %s" % (b, b)}

doc = {
    "AMApplicationBuild": "528",
